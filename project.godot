Fx="*res://scripts/fx.gd"
Sound="*res://scripts/sound.gd"
Music="*res://scripts/music.gd"
Narrator="*res://scripts/narrator.gd"
Weapons="*res://scripts/weapons.gd"
Tactics="*res://scripts/tactics.gd"
Composure="*res://scripts/composure.gd"
FightScore="*res://scripts/fight_score.gd"
Styles="*res://scripts/styles.gd"
Wallet="*res://scripts/wallet.gd"
