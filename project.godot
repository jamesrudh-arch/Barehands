Blocks="*res://scripts/blocks.gd"
WorldSim="*res://scripts/world_sim.gd"
Jobs="*res://scripts/jobs.gd"
Kidnap="*res://scripts/kidnap.gd"
Reactive="*res://scripts/reactive.gd"
Backroom="*res://scripts/backroom.gd"
Traffic="*res://scripts/traffic.gd"
Weather="*res://scripts/weather.gd"
Events="*res://scripts/events.gd"
Fire="*res://scripts/fire.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
[audio]

general/text_to_speech=true
